# ==============================================================================
# Existing n8n Proxy Infrastructure (Preserved: 5678 -> 3000)
# ==============================================================================
PORT=3000
N8N_PORT=5678
N8N_HOST=127.0.0.1
N8N_USER_FOLDER=./.n8n-data

# ==============================================================================
# Model Layer — Provider-Agnostic Configuration (Primary: River AI)
# ==============================================================================
# Primary provider API key (River AI)
RIVER_AI_API=

# Provider settings (openai-compatible; switchable via env without code changes)
PRIMARY_PROVIDER=river_ai
PRIMARY_BASE_URL=https://api.river.ai/v1
PRIMARY_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
PRIMARY_TEMPERATURE=0.2
PRIMARY_MAX_TOKENS=4096
PRIMARY_REASONING_EFFORT=

# Worker model settings (economical model for isolated sub-agents & compaction)
WORKER_PROVIDER=river_ai
WORKER_BASE_URL=https://api.river.ai/v1
WORKER_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
WORKER_API_KEY=
WORKER_TEMPERATURE=0.1
WORKER_MAX_TOKENS=2048

# Optional alternative provider fallback key (only used if PRIMARY_PROVIDER=openai or openrouter)
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Model HTTP timeouts & retry settings
MODEL_TIMEOUT_SECONDS=90
MODEL_MAX_RETRIES=2

# ==============================================================================
# LangGraph Brain, Checkpointing & Loop Protection
# ==============================================================================
CHECKPOINT_DB_PATH=./data/checkpoints.db
WORKSPACE_DIR=./workspace
SKILLS_DIR=./skills
MAX_TURNS=30
MAX_TOOL_RETRIES=2
CONTEXT_COMPACTION_THRESHOLD=4000

# ==============================================================================
# Docker Sandbox Configuration (Local Hands)
# ==============================================================================
# auto = use Docker when daemon is reachable, else local_isolated workspace sandbox
# docker = require Docker daemon strictly
# local_isolated = isolated subprocess confined to WORKSPACE_DIR
SANDBOX_BACKEND=auto
SANDBOX_IMAGE=autonomous-agent-sandbox:latest
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_QUOTA=100000
SANDBOX_CPU_PERIOD=100000
SANDBOX_PIDS_LIMIT=128
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_NETWORK_MODE=bridge

# ==============================================================================
# n8n MCP Integration (SaaS Arm — Streamable HTTP)
# ==============================================================================
# Use http://127.0.0.1:5678/mcp-server/http on same host, or http://n8n:5678/mcp-server/http in Docker network
N8N_MCP_URL=http://localhost:5678/mcp-server/http
N8N_MCP_TOKEN=
# Optional comma-separated allowlist of n8n MCP tool names (empty = allow all discovered tools)
ALLOWED_N8N_TOOLS=
N8N_MCP_TIMEOUT_SECONDS=30

# ==============================================================================
# Python Agent FastAPI Service & Authentication
# ==============================================================================
AGENT_API_HOST=0.0.0.0
AGENT_API_PORT=8100
# Required Bearer token for POST /agent/run and POST /agent/resume
AGENT_API_TOKEN=change-me-to-a-strong-random-token
# Reachable URL used by the n8n Gateway Workflow HTTP Request node
AGENT_API_PUBLIC_URL=http://127.0.0.1:8100