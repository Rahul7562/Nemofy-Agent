# ==============================================================================
# Nemofy Agent — Pure-Python LangGraph Brain & Web Server Configuration
# ==============================================================================

# Web Server Port (serves Nemofy Agent UI + /api/* gateway)
PORT=3000

# Internal Pure-Python Agent-Core FastAPI Port & Auth Token
AGENT_API_PORT=8100
AGENT_API_TOKEN=change-me-to-a-long-random-token

# ------------------------------------------------------------------------------
# Main Agent (Brain) & Sub-Agent (Worker) Default LLM Configuration
# (Can also be updated at runtime in Settings -> LLM Config)
# ------------------------------------------------------------------------------
PRIMARY_PROVIDER=river_ai
PRIMARY_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
PRIMARY_BASE_URL=https://api.river.ai/v1
PRIMARY_TEMPERATURE=0.2
PRIMARY_MAX_TOKENS=4096
PRIMARY_REASONING_EFFORT=off

WORKER_PROVIDER=river_ai
WORKER_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
WORKER_BASE_URL=https://api.river.ai/v1
WORKER_TEMPERATURE=0.1
WORKER_MAX_TOKENS=2048
WORKER_REASONING_EFFORT=off

MAX_TURNS=30

# ------------------------------------------------------------------------------
# Server-Side Provider API Keys (Never exposed to frontend)
# ------------------------------------------------------------------------------
RIVER_AI_API=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=

# ------------------------------------------------------------------------------
# Directories & Sandbox
# ------------------------------------------------------------------------------
WORKSPACE_DIR=./workspace
SKILLS_DIR=./Skills
MCP_CONFIG_PATH=./MCPs/servers.json
LLM_CONFIG_PATH=./data/llm_config.json
CHECKPOINT_DB_PATH=./data/checkpoints.db
SANDBOX_BACKEND=auto
SANDBOX_TIMEOUT_SECONDS=30