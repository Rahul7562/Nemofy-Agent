{
  "name": "nemofy-agent",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "bash scripts/build-runtime-deps.sh && vite build",
    "build:frontend": "vite build",
    "build:host": "npm run build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f --tail=100",
    "docker:config": "docker compose config",
    "firecrawl:install": "bash scripts/install-firecrawl-local.sh",
    "firecrawl:rebuild": "FIRECRAWL_FORCE_REBUILD=1 bash scripts/install-firecrawl-local.sh",
    "firecrawl:serve": "bash scripts/run-firecrawl-local.sh",
    "firecrawl:check": "bash scripts/check-firecrawl.sh",
    "chromium:install": "bash scripts/install-chromium.sh"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
